# Copie este arquivo para .env somente em seu ambiente LOCAL.
# NUNCA versione .env com credenciais reais.
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EXEMPLO
SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_EXEMPLO

# Os valores abaixo são secretos. Configure-os SOMENTE no cofre de secrets das Supabase Edge Functions:
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
# ASAAS_ENV=sandbox
# APP_URL=https://seu-dominio
# Os envs abaixo são secrets de Edge Functions, não de frontend:\n# SOLVCHAT_SEND_URL=\n# SOLVCHAT_TOKEN=\n# SOLVCHAT_OTP_PEPPER=\n# O envio via WhatsApp do SolvChat NÃO utiliza SMS do Supabase.\n# Se o SolvChat for oficial, usar template OTP de autenticação aprovado pela Meta.
