{
  "name": "Beneficio Certo - OTP e Checkout",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "beneficio-certo-solv",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "OTP - Receber",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "webhookId": "a1000000-0000-4000-8000-0000000000a1"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1000000-0000-4000-8000-000000000011", "name": "number", "value": "={{ $json.body.telefone }}", "type": "string" },
            { "id": "a1000000-0000-4000-8000-000000000012", "name": "body", "value": "={{ $json.body.mensagem }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "OTP - Preparar",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [224, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.solvchat.com.br/api/messages/whatsmeow/sendTextGroupPRO",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Authorization", "value": "COLE_AQUI_O_TOKEN_DO_SOLVCHAT" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.number, openTicket: \"1\", queueId: \"0\", body: $json.body }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "OTP - Enviar SolvChat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [448, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"sent\": true\n}",
        "options": { "responseCode": 200 }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "OTP - Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [672, 0]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "beneficio-certo-asaas",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Checkout - Receber",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 288],
      "webhookId": "a1000000-0000-4000-8000-0000000000a2"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1000000-0000-4000-8000-000000000021", "name": "pedido_id", "value": "={{ $json.body.pedido_id }}", "type": "string" },
            { "id": "a1000000-0000-4000-8000-000000000022", "name": "valor", "value": "={{ Number($json.body.valor) }}", "type": "number" },
            { "id": "a1000000-0000-4000-8000-000000000023", "name": "success_url", "value": "={{ $json.body.success_url }}", "type": "string" },
            { "id": "a1000000-0000-4000-8000-000000000024", "name": "cancel_url", "value": "={{ $json.body.cancel_url }}", "type": "string" },
            { "id": "a1000000-0000-4000-8000-000000000025", "name": "expired_url", "value": "={{ $json.body.expired_url }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Checkout - Preparar",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [224, 288]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api-sandbox.asaas.com/v3/checkouts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "User-Agent", "value": "BeneficioCerto/1.0" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ billingTypes: [\"PIX\", \"CREDIT_CARD\"], chargeTypes: [\"DETACHED\"], minutesToExpire: 60, externalReference: $json.pedido_id, items: [{ name: \"Beneficio Certo Premium\", description: \"Acesso ao conteudo informativo do Beneficio Certo\", quantity: 1, value: Number($json.valor) }], callback: { successUrl: $json.success_url, cancelUrl: $json.cancel_url, expiredUrl: $json.expired_url } }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Checkout - Criar no Asaas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [448, 288]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { id: $json.id, url: \"https://asaas.com/checkoutSession/show?id=\" + $json.id } }}",
        "options": { "responseCode": 200 }
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Checkout - Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [672, 288]
    }
  ],
  "connections": {
    "OTP - Receber": { "main": [[{ "node": "OTP - Preparar", "type": "main", "index": 0 }]] },
    "OTP - Preparar": { "main": [[{ "node": "OTP - Enviar SolvChat", "type": "main", "index": 0 }]] },
    "OTP - Enviar SolvChat": { "main": [[{ "node": "OTP - Responder", "type": "main", "index": 0 }]] },
    "Checkout - Receber": { "main": [[{ "node": "Checkout - Preparar", "type": "main", "index": 0 }]] },
    "Checkout - Preparar": { "main": [[{ "node": "Checkout - Criar no Asaas", "type": "main", "index": 0 }]] },
    "Checkout - Criar no Asaas": { "main": [[{ "node": "Checkout - Responder", "type": "main", "index": 0 }]] }
  },
  "pinData": {},
  "settings": {}
}
